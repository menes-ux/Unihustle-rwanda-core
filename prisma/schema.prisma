generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL") // Secured for Supabase pgBouncer
}

model User {
  user_id   Int    @id @default(autoincrement())
  full_name String
  email     String @unique
  role      Role 

  school       String   @default("ALU") 
  skills       String[] 
  hustle_score Int      @default(100)   
  is_alumni    Boolean  @default(false) 

  // to verify the email
  is_verified Boolean @default(false)
  verification_code String?
  verification_expires DateTime?

  // Relations
  gigs            Gig[]           @relation("StudentGigs")
  orders          Order[]         @relation("BusinessOrders")
  portfolio_items PortfolioItem[] 
  reviews_given   Review[]        @relation("BusinessReviews") // Added this!
}

model PortfolioItem {
  portfolio_id Int    @id @default(autoincrement())
  title        String 
  link         String 
  
  student_id   Int
  student      User   @relation(fields: [student_id], references: [user_id])
}

model Gig {
  gig_id   Int       @id @default(autoincrement())
  title    String
  category String
  price    Int       @default(0)
  status   GigStatus

  student_id Int
  student    User @relation("StudentGigs", fields: [student_id], references: [user_id])

  orders  Order[]
  reviews Review[]
}

model Order {
  order_id Int @id @default(autoincrement())

  gig_id   Int
  buyer_id Int 

  gig   Gig  @relation(fields: [gig_id], references: [gig_id])
  buyer User @relation("BusinessOrders", fields: [buyer_id], references: [user_id])

  status OrderStatus
}

model Review {
  review_id Int @id @default(autoincrement())

  gig_id      Int
  reviewer_id Int // Added this so we know WHICH business left the review
  rating      Int
  comment     String

  gig      Gig  @relation(fields: [gig_id], references: [gig_id])
  reviewer User @relation("BusinessReviews", fields: [reviewer_id], references: [user_id])
}

enum Role {
  student
  business
}

enum GigStatus {
  active
  paused
}

enum OrderStatus {
  pending
  in_progress
  completed
  cancelled
}