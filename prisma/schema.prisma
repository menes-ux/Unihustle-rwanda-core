generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  user_id Int @id @default(autoincrement())
  full_name String
  email String @unique
  role Role 
  
  // A student can create many gigs
  gigs Gig[] @relation("StudentGigs")
  
  // A business can place many orders
  orders Order[] @relation("BusinessOrders")
}

model Gig {
  gig_id Int @id @default(autoincrement())
  title String
  category String
  price Int @default(0)
  status GigStatus

  // The Student who created the gig
  student_id Int
  student User @relation("StudentGigs", fields: [student_id], references: [user_id])

  orders Order[]
  reviews Review[]
}

model Order {
  order_id Int @id @default(autoincrement())

  gig_id Int
  buyer_id Int // The Business buying the gig

  gig Gig @relation(fields: [gig_id], references: [gig_id])
  buyer User @relation("BusinessOrders", fields: [buyer_id], references: [user_id])

  status OrderStatus
}

model Review {
  review_id Int @id @default(autoincrement())

  gig_id Int
  rating Int
  comment String

  gig Gig @relation(fields: [gig_id], references: [gig_id])
}

enum Role {
  student
  business
}

enum GigStatus {
  active
  paused
}

enum OrderStatus {
  pending
  in_progress
  completed
  cancelled
}